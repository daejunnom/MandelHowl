{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mandelhowl.dev/schemas/resonance-trajectory-trace.v2.schema.json",
  "title": "MandelHowl deterministic resonance trajectory v2",
  "$ref": "#/$defs/trace",
  "$defs": {
    "contentId": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "keyframe": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sequence", "atSeconds", "frequencyCentiHz"],
      "properties": {
        "sequence": { "type": "integer", "minimum": 0 },
        "atSeconds": { "type": "number", "minimum": 0 },
        "frequencyCentiHz": {
          "type": "integer",
          "minimum": 4500,
          "maximum": 600000
        }
      }
    },
    "trace": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "traceId",
        "modalModelId",
        "initialFrequencyCentiHz",
        "durationSeconds",
        "expectedSettledVolume",
        "keyframes"
      ],
      "properties": {
        "schemaVersion": {
          "const": "mandelhowl.resonance-trajectory-trace.v2"
        },
        "traceId": { "type": "string", "minLength": 1 },
        "modalModelId": { "$ref": "#/$defs/contentId" },
        "initialFrequencyCentiHz": {
          "type": "integer",
          "minimum": 4500,
          "maximum": 600000
        },
        "durationSeconds": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "expectedSettledVolume": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "keyframes": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/keyframe" }
        }
      }
    }
  }
}

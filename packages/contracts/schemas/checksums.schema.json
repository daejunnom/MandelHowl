{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mandelhowl.dev/schemas/checksums.v1.schema.json",
  "title": "MandelHowl dataset checksums v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "algorithm", "files"],
  "properties": {
    "schemaVersion": {
      "const": "mandelhowl.checksums.v1"
    },
    "algorithm": {
      "const": "sha256"
    },
    "files": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "byteLength", "sha256"],
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9][A-Za-z0-9._/-]*$"
          },
          "byteLength": {
            "type": "integer",
            "minimum": 0
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    }
  }
}

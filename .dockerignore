!package.json
!Cargo.toml
!Cargo.lock
!rust-toolchain.toml

!.github
!.github/workflows
!.github/workflows/**

!assets
!assets/generated
!assets/generated/**

!packages
!packages/asset-runtime
!packages/asset-runtime/src
!packages/asset-runtime/src/**
!packages/contracts
!packages/contracts/schemas
!packages/contracts/schemas/**
!packages/contracts/src
!packages/contracts/src/**
!packages/resonance-engine
!packages/resonance-engine/src
!packages/resonance-engine/src/**
!packages/render-engine
!packages/render-engine/src
!packages/render-engine/src/**

!release
!release/dataset-lock.json

!specs
!specs/acceptance
!specs/acceptance/**

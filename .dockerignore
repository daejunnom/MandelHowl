!specs/physics/**
!specs/plate
!specs/plate/**
!specs/runtime
!specs/runtime/**
!specs/visual
!specs/visual/**

!tests
!tests/runtime
!tests/runtime/**

!tools
!tools/baker-supervisor
!tools/baker-supervisor/**
!tools/container-baker-runner
!tools/container-baker-runner/**
!tools/handoff-verifier
!tools/handoff-verifier/**
!tools/physics-baker
!tools/physics-baker/**
!tools/physics-baker-rs
!tools/physics-baker-rs/**
!tools/reachability-generator
!tools/reachability-generator/**
!tools/release-packager
!tools/release-packager/**

# Secrets and credentials remain excluded even inside an allowed source root.
.env
.env.*
**/.env
**/.env.*
**/*service-account*.json
**/*service_account*.json
**/credentials.json
**/credential*.json
**/*credentials*.json
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/id_rsa
**/id_rsa.*
**/id_dsa
**/id_dsa.*
**/id_ecdsa
**/id_ecdsa.*
**/id_ed25519
**/id_ed25519.*
**/*api-key*
**/*api_key*
**/.ssh
**/.ssh/**
**/.aws
**/.aws/**
**/.azure
**/.azure/**
**/.kube
**/.kube/**
**/.npmrc
**/.pypirc
**/.netrc

# Generated/heavy descendants and host executables never become image inputs.
.git
.git/**
**/node_modules
**/node_modules/**
**/dist
**/dist/**
**/dist-server
**/dist-server/**
**/build
**/build/**
**/coverage
**/coverage/**
**/models
**/models/**
**/checkpoints
**/checkpoints/**
**/.cache
**/.cache/**
**/__pycache__
**/__pycache__/**
**/*.pyc
**/*.pyo
target
target/**
tools/physics-baker-rs/bin/**
!tools/physics-baker-rs/bin/README.md
public/runtime
public/runtime/**
work
work/**
.next
.next/**
.vinext
.vinext/**
playwright-report
playwright-report/**
test-results
test-results/**

# Promotion outputs are deliberately not scientific image inputs. The
# supervisor records and the release verifier enforces this exact two-file set.
specs/runtime/dataset-release.v1.yaml
packages/contracts/src/generated/dataset-release.generated.ts

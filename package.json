{
  "name": "mandelhowl",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "cross-env WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "prebuild": "npm run assets:stage",
    "build": "cross-env WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "start": "cross-env WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "assets:stage": "node tools/release-packager/src/write-security-headers.mjs --check && npm run licenses:check && node tools/release-packager/src/stage-runtime-assets.mjs && node tools/release-packager/src/build-provenance.mjs",
    "contracts:generate": "node packages/contracts/scripts/generate-runtime-specs.mjs",
    "contracts:check": "node packages/contracts/scripts/generate-runtime-specs.mjs --check",
    "typecheck": "tsc --noEmit --pretty false",
    "test": "npm run test:unit && npm run test:web && npm run test:integration && npm run test:science && npm run build && npm run test:ssr",
    "test:unit": "vitest run --config vitest.config.ts",
    "test:web": "vitest run --config tests/web/vitest.config.ts",
    "test:integration": "vitest run --config tests/integration/vitest.config.ts",
    "test:science": "python -m unittest discover -s tests/science -p \"test_*.py\"",
    "test:ssr": "node --test tests/rendered-html.test.mjs",
    "test:e2e": "playwright test tests/e2e --project=chromium-desktop",
    "test:visual": "playwright test tests/visual --project=chromium-desktop",
    "test:visual:update": "playwright test tests/visual --project=chromium-desktop --update-snapshots",
    "test:performance": "playwright test tests/performance --project=chromium-desktop",
    "test:browser": "npm run test:e2e && npm run test:visual && npm run test:performance",
    "baker:rust:check": "cargo fmt --all -- --check && cargo clippy --workspace --all-targets --locked -- -D warnings",
    "baker:rust:test": "cargo test --workspace --locked",
    "svelte:check": "svelte-check --workspace apps/svelte-prototype --tsconfig ./tsconfig.json --fail-on-warnings",
    "physics:validate": "node tools/release-packager/src/validate-pinned-dataset.mjs",
    "physics:validate:strict": "node tools/release-packager/src/validate-pinned-dataset.mjs --require-rust",
    "security:static": "node tools/release-packager/src/verify-forbidden-runtime.mjs && node tools/release-packager/src/write-security-headers.mjs --check",
    "security:audit": "npm audit --audit-level=high",
    "licenses:generate": "node tools/release-packager/src/generate-license-inventory.mjs",
    "licenses:check": "node tools/release-packager/src/generate-license-inventory.mjs --check",
    "release:archive": "node tools/release-packager/src/create-release-archive.mjs",
    "release:archive:check": "node tools/release-packager/src/create-release-archive.mjs --check",
    "release:verify": "node tools/release-packager/src/verify-release.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern .vinext --ignore-pattern playwright-report --ignore-pattern test-results --ignore-pattern public/runtime --ignore-pattern outputs",
    "verify": "npm run contracts:check && npm run typecheck && npm run lint && npm run svelte:check && npm run baker:rust:check && npm run security:audit && npm run security:static && npm test && npm run test:browser"
  },
  "dependencies": {
    "next": "^16.2.12",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.48.0",
    "@playwright/test": "^1.62.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.2.12",
    "react-server-dom-webpack": "^19.2.8",
    "svelte": "^5.56.8",
    "svelte-check": "^4.7.4",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "^8.1.5",
    "vitest": "^4.1.10",
    "wrangler": "^4.115.0"
  },
  "overrides": {
    "minimatch@3.1.5": "file:tools/minimatch-legacy-bridge",
    "next": {
      "postcss": "8.5.18",
      "sharp": "0.35.0"
    }
  },
  "type": "module"
}
